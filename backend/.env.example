APP_NAME=Aether
APP_ENV=development
APP_DEBUG=true
LOCAL_AUTH_MODE=true

DATABASE_URL=mysql+aiomysql://root:@localhost:3306/aether_db

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CODING_MODEL=cohere/north-mini-code:free

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local visible browser automation. Add only exact hostnames you trust.
AETHER_BROWSER_ENABLED=false
AETHER_BROWSER_PROFILE_DIR=~/.aether/browser-profile
AETHER_BROWSER_ALLOWED_HOSTS=web.whatsapp.com,www.youtube.com,youtube.com,www.instagram.com,instagram.com
AETHER_BROWSER_SHARE_PAGE_CONTENT_WITH_MODEL=false
AETHER_BROWSER_MAX_PAGE_CHARS=12000

REDIS_URL=
WEATHER_API_KEY=
